          }
        },
        {
          "name": "m.x + 1",
          "vars": {
            "query": "MATCH (s)-[:F2Prefix]->(m)-[:F2Next]->(e {x: m.x + 1}) RETURN id(e) = $matching"
          },
          "assert": {
            "row_count": 0,
            "row_values": []
          }
        },
        {
          "name": "mutation filters matching endpoint",
          "vars": {
            "query": "MATCH (s)-[:F2Prefix]->(m)-[:F2Next]->(e {x: m.x}) SET e.selected = true RETURN id(e) = $matching"
          },
          "assert": {
            "row_values": [
              [
                true
              ]
            ]
          },
          "post_assertions": [
            {
              "cypher": "MATCH (n) WHERE n.selected = true RETURN n",
              "assert": {
                "node_ids": [
                  "match"
                ]
              }
            }
          ]
        }
      ]
    },
