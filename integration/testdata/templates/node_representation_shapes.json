{
  "families": [
    {
      "name": "F1 carried node identity and integer consumers",
      "template": "{{query}}",
      "fixture": {
        "nodes": [
          {
            "id": "source",
            "kinds": [
              "F1Node"
            ],
            "properties": {
              "name": "source"
            }
          },
          {
            "id": "target",
            "kinds": [
              "F1Node"
            ],
            "properties": {
              "name": "target"
            }
          },
          {
            "id": "far",
            "kinds": [
              "F1Node"
            ],
            "properties": {
              "name": "far"
            }
          }
        ],
        "edges": [
          {
            "start_id": "source",
            "end_id": "target",
            "kind": "F1Edge"
          },
          {
            "start_id": "target",
            "end_id": "far",
            "kind": "F1Edge"
          }
        ]
      },
      "node_params": {
        "source": "source",
        "target": "target"
      },
      "variants": [
        {
          "name": "fixed",
          "vars": {
            "query": "MATCH (a) WHERE a.name = 'source' WITH a MATCH (a)-[:F1Edge]->(b) RETURN id(a) = $source, id(b) = $target"
          },
          "assert": {
            "row_count": 1,
            "row_values": [
              [
                true,
                true
              ]
            ]
          }
        },
        {
          "name": "fixed alias",
          "vars": {
            "query": "MATCH (original) WHERE original.name = 'source' WITH original AS a MATCH (a)-[:F1Edge]->(b) RETURN id(a) = $source, id(b) = $target"
          },
          "assert": {
            "row_count": 1,
            "row_values": [
              [
                true,
                true
              ]
            ]
          }
        },
        {
          "name": "one hop",
          "vars": {
            "query": "MATCH (a) WHERE a.name = 'source' WITH a MATCH (a)-[:F1Edge*1..1]->(b) RETURN id(a) = $source, id(b) = $target"
          },
          "assert": {
            "row_count": 1,
            "row_values": [
              [
                true,
                true
              ]
            ]
          }
        },
        {
          "name": "one hop alias",
          "vars": {
            "query": "MATCH (original) WHERE original.name = 'source' WITH original AS a MATCH (a)-[:F1Edge*1..1]->(b) RETURN id(a) = $source, id(b) = $target"
          },
          "assert": {
            "row_count": 1,
            "row_values": [
              [
                true,
                true
              ]
            ]
          }
        },
        {
          "name": "variable",
          "vars": {
            "query": "MATCH (a) WHERE a.name = 'source' WITH a MATCH (a)-[:F1Edge*1..2]->(b) RETURN id(a) = $source, id(b) = $target"
          },
          "assert": {
            "row_count": 2,
            "row_values": [
              [
                true,
                true
              ],
              [
                true,
                false
              ]
            ]
          }
        },
        {
          "name": "variable alias",
          "vars": {
            "query": "MATCH (original) WHERE original.name = 'source' WITH original AS a MATCH (a)-[:F1Edge*1..2]->(b) RETURN id(a) = $source, id(b) = $target"
          },
          "assert": {
            "row_count": 2,
            "row_values": [
              [
                true,
                true
              ],
              [
                true,
                false
              ]
            ]
          }
        },
        {
          "name": "zero",
          "vars": {
            "query": "MATCH (a) WHERE a.name = 'source' WITH a MATCH (a)-[:F1Edge*0..0]->(b) RETURN id(a) = $source, id(b) = $target"
          },
          "assert": {
            "row_count": 1,
            "row_values": [
              [
                true,
                false
              ]
            ]
          }
        },
        {
          "name": "zero alias",
          "vars": {
            "query": "MATCH (original) WHERE original.name = 'source' WITH original AS a MATCH (a)-[:F1Edge*0..0]->(b) RETURN id(a) = $source, id(b) = $target"
          },
          "assert": {
            "row_count": 1,
            "row_values": [
              [
                true,
                false
              ]
            ]
          }
        },
        {
          "name": "mutation preserves carried entity",
          "vars": {
            "query": "MATCH (a) WHERE a.name = 'source' WITH a MATCH (a)-[:F1Edge]->(b) SET b.selected = true RETURN id(a) = $source, id(b) = $target"
          },
          "assert": {
            "row_values": [
              [
                true,
                true
              ]
            ]
          },
          "post_assertions": [
            {
              "cypher": "MATCH (n) WHERE n.selected = true RETURN n",
              "assert": {
                "node_ids": [
                  "target"
                ]
              }
            }
          ]
        }
      ]
    },
    {
