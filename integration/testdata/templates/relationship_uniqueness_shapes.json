        {
          "name": "create cardinality with return",
          "vars": {"query": "MATCH (a:UniqueRoot {name:'a'})-[:UniqueR {marker:'yes'}]->(x), (a)-[:UniqueR {marker:'yes'}]->(y) CREATE (audit:UniqueAudit {target:x.name + y.name}) RETURN audit.target ORDER BY audit.target"},
          "assert": {
            "ordered_row_values": [["bc"], ["cb"]],
            "row_count": 2
          },
          "post_assertions": [
            {
              "cypher": "MATCH (n:UniqueAudit) RETURN n.target ORDER BY n.target",
              "assert": {
                "ordered_row_values": [["bc"], ["cb"]],
                "row_count": 2
              }
            },
            {
              "cypher": "MATCH (n) WHERE NOT n:UniqueAudit RETURN n",
              "assert": {
                "node_records": [
                  {"id": "a", "kinds": ["UniqueRoot"], "props": {"name": "a"}},
                  {"id": "b", "kinds": ["UniqueNode"], "props": {"name": "b"}},
                  {"id": "c", "kinds": ["UniqueNode"], "props": {"name": "c"}},
                  {"id": "d", "kinds": ["UniqueNode"], "props": {"name": "d"}},
                  {"id": "incoming", "kinds": ["UniqueNode"], "props": {"name": "incoming"}},
                  {"id": "other", "kinds": ["UniqueRoot"], "props": {"name": "other"}},
                  {"id": "isolated", "kinds": ["UniqueRoot"], "props": {"name": "isolated"}},
                  {"id": "wrong", "kinds": ["UniqueNode"], "props": {"name": "wrong"}}
                ]
              }
            },
            {
              "cypher": "MATCH ()-[r]->() RETURN r",
              "assert": {
                "relationship_records": [
                  {"start": "a", "end": "b", "kind": "UniqueR", "props": {"marker": "yes"}},
                  {"start": "a", "end": "c", "kind": "UniqueR", "props": {"marker": "yes"}},
                  {"start": "b", "end": "a", "kind": "UniqueR", "props": {"marker": "yes"}},
                  {"start": "b", "end": "c", "kind": "UniqueR", "props": {"marker": "yes"}},
                  {"start": "c", "end": "a", "kind": "UniqueR", "props": {"marker": "yes"}},
