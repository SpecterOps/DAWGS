{
  "families": [
    {
      "name": "Boolean values and predicate boundaries",
      "template": "{{query}}",
      "fixture": {
        "nodes": [
          {"id": "0", "kinds": ["BooleanValue"], "properties": {"k": 0, "keep": "value"}},
          {"id": "1", "kinds": ["BooleanValue"], "properties": {"k": 1, "keep": "value"}},
          {"id": "2", "kinds": ["BooleanValue"], "properties": {"k": 2, "keep": "value"}},
          {"id": "3", "kinds": ["BooleanValue"], "properties": {"k": 3, "keep": "value"}},
          {"id": "missing", "kinds": ["BooleanValue"], "properties": {"keep": "missing"}}
        ],
        "edges": []
      },
      "variants": [
        {
          "name": "direct unwind projection",
          "vars": {"query": "UNWIND [1,2,3] AS x RETURN x, x > 1 AND x < 3 AS mid ORDER BY x"},
          "assert": {
            "ordered_row_values": [
              [1, false],
              [2, true],
              [3, false]
            ],
            "row_count": 3
          }
        },
        {
          "name": "three conjoined terms",
          "vars": {"query": "UNWIND [1,2,3] AS x WITH x RETURN x, x > 0 AND x < 3 AND x <> 1 AS mid ORDER BY x"},
          "assert": {
            "ordered_row_values": [
              [1, false],
              [2, true],
              [3, false]
            ],
            "row_count": 3
          }
        },
        {
          "name": "mixed conjunction and disjunction",
          "vars": {"query": "UNWIND [1,2,3] AS x WITH x RETURN x, x = 1 OR x > 1 AND x < 3 AS mid ORDER BY x"},
          "assert": {
            "ordered_row_values": [
              [1, true],
              [2, true],
              [3, false]
            ],
            "row_count": 3
          }
        },
        {
          "name": "separate Boolean projection items",
          "vars": {"query": "UNWIND [1,2,3] AS x WITH x RETURN x, x > 1 AND x < 3 AS mid, x = 1 OR x = 3 AS outer ORDER BY x"},
          "assert": {
            "ordered_row_values": [
              [1, false, true],
              [2, true, false],
              [3, false, true]
            ],
            "row_count": 3
          }
        },
        {
          "name": "parenthesized conjunction",
          "vars": {"query": "UNWIND [1,2,3] AS x WITH x RETURN x, (x > 1 AND x < 3) AS mid ORDER BY x"},
          "assert": {
            "ordered_row_values": [
              [1, false],
              [2, true],
              [3, false]
            ],
            "row_count": 3
          }
        },
        {
          "name": "function argument",
          "vars": {"query": "UNWIND [1,2,3] AS x WITH x RETURN x, coalesce(x > 1 AND x < 3, false) AS mid ORDER BY x"},
          "assert": {
            "ordered_row_values": [
              [1, false],
              [2, true],
              [3, false]
            ],
            "row_count": 3
          }
        },
        {
          "name": "parameter conjunction",
          "vars": {"query": "UNWIND [1,2,3] AS x WITH x RETURN x, x > $low AND x < $high AS mid ORDER BY x"},
          "assert": {
            "ordered_row_values": [
              [1, false],
              [2, true],
              [3, false]
            ],
            "row_count": 3
          },
          "params": {"low": 1, "high": 3}
        },
        {
          "name": "with value then filter",
          "vars": {"query": "UNWIND [1,2,3] AS x WITH x, x > 1 AND x < 3 AS mid WHERE x >= 1 AND x <= 3 RETURN x, mid ORDER BY x"},
          "assert": {
            "ordered_row_values": [
              [1, false],
              [2, true],
              [3, false]
            ],
            "row_count": 3
          }
        },
        {
          "name": "where function argument",
          "vars": {"query": "UNWIND [1,2,3] AS x WITH x WHERE coalesce(x > 1 AND x < 3, false) RETURN x ORDER BY x"},
          "assert": {
            "ordered_row_values": [
              [2]
            ],
            "row_count": 1
          }
        },
        {
          "name": "where conjunction and disjunction",
          "vars": {"query": "UNWIND [1,2,3] AS x WITH x WHERE x > 0 AND (x = 1 OR x = 3) RETURN x ORDER BY x"},
          "assert": {
            "ordered_row_values": [
              [1],
              [3]
            ],
            "row_count": 2
          }
        },
        {
          "name": "missing property Boolean values",
          "vars": {"query": "MATCH (n:BooleanValue) RETURN n.k AS k, n.k > 0 AND n.k < 2 AS mid ORDER BY k"},
          "assert": {
            "ordered_row_values": [
              [0, false],
              [1, true],
              [2, false],
              [3, false],
              [null, null]
            ],
            "row_count": 5
          }
        },
        {
          "name": "false with missing property",
          "vars": {"query": "MATCH (n:BooleanValue) RETURN n.k AS k, false AND n.k < 2 AS mid ORDER BY k"},
          "assert": {
            "ordered_row_values": [
              [0, false],
              [1, false],
              [2, false],
              [3, false],
              [null, false]
            ],
            "row_count": 5
          }
        }
      ]
    },
