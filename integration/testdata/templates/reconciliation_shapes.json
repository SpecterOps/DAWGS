    {
      "name": "REC-02 outbound structure reconciliation delete",
      "template": "MATCH (s:ADEntity)-[r:{{relationship_kinds}}]->() WHERE s.objectid = $object_id DELETE r",
      "fixture": {
        "nodes": [
          {"id": "target", "kinds": ["ADEntity", "Computer"], "properties": {"objectid": "target-out"}},
          {"id": "one-target", "kinds": ["ADEntity"], "properties": {"objectid": "one-out"}},
          {"id": "wrong-kind", "kinds": ["OtherEntity"], "properties": {"objectid": "target-out"}},
