{
  "families": [
    {
      "name": "F5 additional source label excludes ineligible sources",
      "template": "MATCH (s:User) MATCH {{pattern}} WITH s, count({{count}}) AS c {{update}} RETURN s AS source, c AS total ORDER BY total DESC LIMIT {{limit}}",
      "fixture": {
        "nodes": [
          {
            "id": "user-only",
            "kinds": [
              "User"
            ],
            "properties": {}
          },
          {
            "id": "target",
            "kinds": [
              "Computer"
            ],
            "properties": {}
          }
        ],
        "edges": [
          {
            "start_id": "user-only",
            "end_id": "target",
            "kind": "MemberOf",
            "properties": {}
          }
        ]
      },
      "variants": [
        {
          "name": "F5 missing label terminal count",
          "vars": {
            "pattern": "(s:Group)-[:MemberOf*1..2]->(t)",
            "count": "t",
            "limit": "10",
            "update": ""
          },
          "assert": {
            "row_count": 0,
            "ordered_node_ids": [],
            "ordered_column_values": {
              "total": []
            }
          }
        },
        {
          "name": "F5 missing label row count",
          "vars": {
            "pattern": "(s:Group)-[:MemberOf*1..2]->(t)",
            "count": "*",
            "limit": "10",
            "update": ""
          },
          "assert": {
            "row_count": 0,
            "ordered_node_ids": [],
            "ordered_column_values": {
              "total": []
            }
          }
        },
        {
          "name": "F5 mutation cannot select missing label",
          "vars": {
            "pattern": "(s:Group)-[:MemberOf*1..2]->(t)",
            "count": "t",
            "limit": "10",
            "update": "SET s.selected = true"
          },
          "assert": {
            "row_count": 0,
            "ordered_node_ids": [],
            "ordered_column_values": {
              "total": []
            }
          },
          "post_assertions": [
            {
              "cypher": "MATCH (s) WHERE s.selected = true RETURN s",
              "assert": {
                "node_id_set": []
              }
            }
          ]
        }
      ]
    },
