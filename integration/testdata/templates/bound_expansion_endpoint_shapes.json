        ],
        "edges": [
          {"start_id": "a", "end_id": "mid-a", "kind": "F4Prefix"},
          {"start_id": "b", "end_id": "mid-b", "kind": "F4Prefix"},
          {"start_id": "mid-a", "end_id": "a", "kind": "F4Expand"},
          {"start_id": "mid-a", "end_id": "b", "kind": "F4Expand"},
          {"start_id": "mid-b", "end_id": "b", "kind": "F4Expand"},
