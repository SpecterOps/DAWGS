        {
          "name": "terminal carried through WITH",
          "vars": {"carried": "MATCH (a) WHERE a.name = 'shared' WITH a", "depth": "1..2", "update": "", "result": "a, p"},
          "assert": {
            "row_count": 2,
            "node_records": [
              {"id": "source", "kinds": ["F4Node"], "props": {"name": "shared"}},
