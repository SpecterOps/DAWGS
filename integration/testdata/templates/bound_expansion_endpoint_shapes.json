{
  "families": [
    {
      "name": "F4 outbound distinct terminals are not cycles",
      "template": "{{carried}} MATCH p = (a)-[:F4Prefix]->(mid)-[:F4Expand*{{depth}}]->(a) WHERE a.name = 'shared' {{update}} RETURN {{result}}",
      "fixture": {
        "nodes": [
          {"id": "source", "kinds": ["F4Node"], "properties": {"name": "shared"}},
          {"id": "mid", "kinds": ["F4Node"], "properties": {"name": "mid"}},
          {"id": "via", "kinds": ["F4Node"], "properties": {"name": "via"}},
          {"id": "decoy", "kinds": ["F4Node"], "properties": {"name": "decoy"}},
          {"id": "far", "kinds": ["F4Node"], "properties": {"name": "far"}}
        ],
        "edges": [
          {"start_id": "source", "end_id": "mid", "kind": "F4Prefix"},
          {"start_id": "mid", "end_id": "decoy", "kind": "F4Expand"},
          {"start_id": "decoy", "end_id": "far", "kind": "F4Expand"}
        ]
      },
      "variants": [
        {
          "name": "one and two hops",
          "vars": {"carried": "", "depth": "1..2", "update": "", "result": "a, p"},
          "assert": {"row_count": 0, "node_records": [], "path_node_ids": [], "path_lengths": []}
        },
        {
          "name": "recursive terminal",
          "vars": {"carried": "", "depth": "2..2", "update": "", "result": "a, p"},
          "assert": {"row_count": 0, "node_records": [], "path_node_ids": [], "path_lengths": []}
        },
        {
          "name": "zero depth excludes distinct prefix",
          "vars": {"carried": "", "depth": "0..0", "update": "", "result": "a, p"},
          "assert": {"row_count": 0, "node_records": [], "path_node_ids": [], "path_lengths": []}
        },
        {
          "name": "zero and positive depths",
          "vars": {"carried": "", "depth": "0..2", "update": "", "result": "a, p"},
          "assert": {"row_count": 0, "node_records": [], "path_node_ids": [], "path_lengths": []}
        },
        {
          "name": "terminal carried through WITH",
          "vars": {"carried": "MATCH (a) WHERE a.name = 'shared' WITH a", "depth": "1..2", "update": "", "result": "a, p"},
          "assert": {"row_count": 0, "node_records": [], "path_node_ids": [], "path_lengths": []}
        },
        {
          "name": "mutation preserves endpoint selection",
          "vars": {"carried": "", "depth": "1..2", "update": "WITH DISTINCT a SET a.selected = true", "result": "a"},
          "assert": {"row_count": 0, "node_records": []},
          "post_assertions": [{"cypher": "MATCH (n) WHERE n.selected = true RETURN n", "assert": {"node_records": []}}]
        }
      ]
    },
