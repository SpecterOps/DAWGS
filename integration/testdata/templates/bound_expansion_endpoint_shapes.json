    {
      "name": "F4 terminal identity remains correlated with each prefix row",
      "template": "{{carried}} MATCH p = (a)-[:F4Prefix]->(mid)-[:F4Expand*1..2]->(a) RETURN a, p",
      "fixture": {
        "nodes": [
          {"id": "a", "kinds": ["F4Node"], "properties": {}},
          {"id": "b", "kinds": ["F4Node"], "properties": {}},
          {"id": "mid-a", "kinds": ["F4Node"], "properties": {}},
