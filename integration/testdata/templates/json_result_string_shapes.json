          "params": {
            "value": "[1, 2]"
          },
          "assert": {
            "row_count": 1,
            "ordered_column_values": {
              "value": [
                "[1, 2]"
              ]
            }
          },
          "post_assertions": [
            {
              "cypher": "MATCH (n:JSONText) RETURN n",
              "assert": {
                "node_records": [
                  {"id": "target", "kinds": ["JSONText"], "props": {"role": "target", "value": "[1, 2]", "keep": "untouched"}},
                  {"id": "decoy", "kinds": ["JSONText"], "props": {"role": "decoy", "value": "original", "keep": "untouched"}}
                ]
              }
            },
            {
              "cypher": "MATCH ()-[r:JSONTextEdge]->() RETURN r",
              "assert": {
                "relationship_records": [
                  {"start": "target", "end": "decoy", "kind": "JSONTextEdge", "props": {"role": "target", "value": "original", "keep": "untouched"}}
                ]
              }
            }
          ]
