{
  "families": [
    {
      "name": "JSON-like string mutation results",
      "template": "{{query}}",
      "fixture": {
        "nodes": [
          {"id": "target", "kinds": ["JSONText"], "properties": {"role": "target", "value": "original", "keep": "untouched"}},
          {"id": "decoy", "kinds": ["JSONText"], "properties": {"role": "decoy", "value": "original", "keep": "untouched"}}
        ],
        "edges": [
          {
            "start_id": "target",
            "end_id": "decoy",
            "kind": "JSONTextEdge",
            "properties": {
              "role": "target",
              "value": "original",
              "keep": "untouched"
            }
          }
        ]
      },
      "variants": [
        {
          "name": "SET node array",
          "vars": {
            "query": "MATCH (n:JSONText {role:'target'}) SET n.value = $value RETURN n.value AS value"
