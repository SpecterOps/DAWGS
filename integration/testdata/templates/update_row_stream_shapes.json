{
  "families": [
    {
      "name": "updates preserve input row multiplicity and null targets",
      "template": "{{query}}",
      "fixture": {
        "nodes": [
          {"id": "source", "kinds": ["UpdateSource"], "properties": {"name": "source"}},
          {"id": "isolated", "kinds": ["UpdateSource"], "properties": {"name": "isolated"}},
          {"id": "one", "kinds": ["UpdateTarget"], "properties": {"name": "one"}},
          {"id": "two", "kinds": ["UpdateTarget"], "properties": {"name": "two"}},
          {"id": "decoy", "kinds": ["UpdateDecoy"], "properties": {"name": "decoy"}}
        ],
        "edges": [
          {"start_id": "source", "end_id": "one", "kind": "UpdateLink", "properties": {"marker": "one"}},
          {"start_id": "source", "end_id": "two", "kind": "UpdateLink", "properties": {"marker": "two"}},
          {"start_id": "source", "end_id": "decoy", "kind": "OtherUpdateLink", "properties": {"marker": "decoy"}},
          {"start_id": "one", "end_id": "source", "kind": "UpdateLink", "properties": {"marker": "reverse"}}
        ]
      },
      "variants": [
        {
          "name": "fan out node updates",
          "vars": {
            "query": "MATCH (x:UpdateSource)-[r:UpdateLink]->(y:UpdateTarget) SET x.src = true, y.dst = true RETURN x.name, y.name, x.src, y.dst ORDER BY y.name"
          },
          "assert": {"row_count": 2, "ordered_row_values": [["source", "one", true, true], ["source", "two", true, true]]},
          "post_assertions": [
            {
              "cypher": "MATCH (n) RETURN n",
              "assert": {
                "node_records": [
                  {"id": "source", "kinds": ["UpdateSource"], "props": {"name": "source", "src": true}},
                  {"id": "isolated", "kinds": ["UpdateSource"], "props": {"name": "isolated"}},
                  {"id": "one", "kinds": ["UpdateTarget"], "props": {"name": "one", "dst": true}},
                  {"id": "two", "kinds": ["UpdateTarget"], "props": {"name": "two", "dst": true}},
                  {"id": "decoy", "kinds": ["UpdateDecoy"], "props": {"name": "decoy"}}
                ]
              }
            },
            {
              "cypher": "MATCH ()-[r]->() RETURN r",
              "assert": {
                "relationship_records": [
                  {"start": "source", "end": "one", "kind": "UpdateLink", "props": {"marker": "one"}},
                  {"start": "source", "end": "two", "kind": "UpdateLink", "props": {"marker": "two"}},
                  {"start": "source", "end": "decoy", "kind": "OtherUpdateLink", "props": {"marker": "decoy"}},
                  {"start": "one", "end": "source", "kind": "UpdateLink", "props": {"marker": "reverse"}}
                ]
              }
            }
          ]
        },
        {
          "name": "repeated source is the last target",
          "vars": {
            "query": "MATCH (x:UpdateSource)-[r:UpdateLink]->(y:UpdateTarget) SET y.dst = true, x.src = true RETURN x.name, y.name, x.src, y.dst ORDER BY y.name"
          },
          "assert": {"row_count": 2, "ordered_row_values": [["source", "one", true, true], ["source", "two", true, true]]},
          "post_assertions": [
            {
              "cypher": "MATCH (n) RETURN n",
              "assert": {
                "node_records": [
                  {"id": "source", "kinds": ["UpdateSource"], "props": {"name": "source", "src": true}},
                  {"id": "isolated", "kinds": ["UpdateSource"], "props": {"name": "isolated"}},
                  {"id": "one", "kinds": ["UpdateTarget"], "props": {"name": "one", "dst": true}},
                  {"id": "two", "kinds": ["UpdateTarget"], "props": {"name": "two", "dst": true}},
                  {"id": "decoy", "kinds": ["UpdateDecoy"], "props": {"name": "decoy"}}
                ]
              }
            },
            {
              "cypher": "MATCH ()-[r]->() RETURN r",
              "assert": {
                "relationship_records": [
                  {"start": "source", "end": "one", "kind": "UpdateLink", "props": {"marker": "one"}},
                  {"start": "source", "end": "two", "kind": "UpdateLink", "props": {"marker": "two"}},
                  {"start": "source", "end": "decoy", "kind": "OtherUpdateLink", "props": {"marker": "decoy"}},
                  {"start": "one", "end": "source", "kind": "UpdateLink", "props": {"marker": "reverse"}}
                ]
              }
            }
          ]
        },
        {
          "name": "single repeated node retains rows",
