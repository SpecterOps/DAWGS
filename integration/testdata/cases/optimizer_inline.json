        "path_edge_kinds": [
          ["Expand", "OptionA", "JoinSuffix", "HeadToBridge", "ReachTerminal"],
          ["Expand", "OptionB", "JoinSuffix", "HeadToBridge", "ReachTerminal"]
        ]
      }
    },
