{
  "cases": [
    {
      "name": "shortest path picks direct edge over longer route",
      "cypher": "MATCH p = allShortestPaths((s)-[*1..]->(e)) WHERE s.name = 'a' AND e.name = 'd' RETURN p",
      "fixture": {
        "nodes": [
          {"id": "a", "kinds": ["NodeKind1"], "properties": {"name": "a"}},
          {"id": "b", "kinds": ["NodeKind1"], "properties": {"name": "b"}},
          {"id": "c", "kinds": ["NodeKind1"], "properties": {"name": "c"}},
          {"id": "d", "kinds": ["NodeKind1"], "properties": {"name": "d"}}
        ],
        "edges": [
          {"start_id": "a", "end_id": "b", "kind": "EdgeKind1"},
          {"start_id": "b", "end_id": "c", "kind": "EdgeKind1"},
          {"start_id": "c", "end_id": "d", "kind": "EdgeKind1"},
          {"start_id": "a", "end_id": "d", "kind": "EdgeKind1"}
        ]
      },
      "assert": {"row_count": 1, "path_node_ids": [["a", "d"]]}
    },
    {
      "name": "multiple shortest paths of equal length",
      "cypher": "MATCH p = allShortestPaths((s)-[*1..]->(e)) WHERE s.name = 'a' AND e.name = 'd' RETURN p",
      "fixture": {
        "nodes": [
          {"id": "a", "kinds": ["NodeKind1"], "properties": {"name": "a"}},
          {"id": "b", "kinds": ["NodeKind1"], "properties": {"name": "b"}},
          {"id": "c", "kinds": ["NodeKind1"], "properties": {"name": "c"}},
          {"id": "d", "kinds": ["NodeKind1"], "properties": {"name": "d"}}
        ],
        "edges": [
          {"start_id": "a", "end_id": "b", "kind": "EdgeKind1"},
          {"start_id": "a", "end_id": "c", "kind": "EdgeKind1"},
          {"start_id": "b", "end_id": "d", "kind": "EdgeKind1"},
          {"start_id": "c", "end_id": "d", "kind": "EdgeKind1"}
        ]
      },
      "assert": {"row_count": 2, "path_node_ids": [["a", "b", "d"], ["a", "c", "d"]]}
    },
    {
      "name": "no path between disconnected nodes",
      "cypher": "MATCH p = allShortestPaths((s)-[*1..]->(e)) WHERE s.name = 'a' AND e.name = 'b' RETURN p",
      "fixture": {
        "nodes": [
          {"id": "a", "kinds": ["NodeKind1"], "properties": {"name": "a"}},
          {"id": "b", "kinds": ["NodeKind1"], "properties": {"name": "b"}}
        ],
        "edges": []
      },
      "assert": "empty"
    },
    {
      "name": "three shortest paths through a wide fan",
      "cypher": "MATCH p = allShortestPaths((s)-[*1..]->(e)) WHERE s.name = 'a' AND e.name = 'e' RETURN p",
      "fixture": {
        "nodes": [
          {"id": "a", "kinds": ["NodeKind1"], "properties": {"name": "a"}},
          {"id": "b", "kinds": ["NodeKind1"], "properties": {"name": "b"}},
          {"id": "c", "kinds": ["NodeKind1"], "properties": {"name": "c"}},
          {"id": "d", "kinds": ["NodeKind1"], "properties": {"name": "d"}},
          {"id": "e", "kinds": ["NodeKind1"], "properties": {"name": "e"}}
        ],
        "edges": [
          {"start_id": "a", "end_id": "b", "kind": "EdgeKind1"},
          {"start_id": "a", "end_id": "c", "kind": "EdgeKind1"},
          {"start_id": "a", "end_id": "d", "kind": "EdgeKind1"},
          {"start_id": "b", "end_id": "e", "kind": "EdgeKind1"},
          {"start_id": "c", "end_id": "e", "kind": "EdgeKind1"},
          {"start_id": "d", "end_id": "e", "kind": "EdgeKind1"}
        ]
      },
      "assert": {"row_count": 3, "path_node_ids": [["a", "b", "e"], ["a", "c", "e"], ["a", "d", "e"]]}
    },
    {
      "name": "dead end branch does not affect shortest path",
      "cypher": "MATCH p = allShortestPaths((s)-[*1..]->(e)) WHERE s.name = 'a' AND e.name = 'c' RETURN p",
      "fixture": {
        "nodes": [
          {"id": "a", "kinds": ["NodeKind1"], "properties": {"name": "a"}},
          {"id": "b", "kinds": ["NodeKind1"], "properties": {"name": "b"}},
          {"id": "c", "kinds": ["NodeKind1"], "properties": {"name": "c"}},
          {"id": "d", "kinds": ["NodeKind1"], "properties": {"name": "d"}}
        ],
        "edges": [
          {"start_id": "a", "end_id": "b", "kind": "EdgeKind1"},
          {"start_id": "b", "end_id": "c", "kind": "EdgeKind1"},
          {"start_id": "a", "end_id": "d", "kind": "EdgeKind1"}
        ]
      },
      "assert": {"row_count": 1, "path_node_ids": [["a", "b", "c"]]}
    },
    {
      "name": "shortest path with aliased group aggregation orders by user count",
      "cypher": "MATCH p=shortestPath((u:User)-[:MemberOf*1..]->(g:Group)) WITH DISTINCT g AS Group, COUNT(u) AS UserCount RETURN Group.name, UserCount ORDER BY UserCount DESC LIMIT 5",
      "fixture": {
        "nodes": [
          {"id": "u1", "kinds": ["User"], "properties": {"name": "u1"}},
          {"id": "u2", "kinds": ["User"], "properties": {"name": "u2"}},
          {"id": "u3", "kinds": ["User"], "properties": {"name": "u3"}},
          {"id": "admins", "kinds": ["Group"], "properties": {"name": "admins"}},
          {"id": "staff", "kinds": ["Group"], "properties": {"name": "staff"}}
        ],
        "edges": [
          {"start_id": "u1", "end_id": "admins", "kind": "MemberOf"},
          {"start_id": "u2", "end_id": "admins", "kind": "MemberOf"},
          {"start_id": "u3", "end_id": "staff", "kind": "MemberOf"}
        ]
      },
      "assert": {"ordered_row_values": [["admins", 2], ["staff", 1]]}
    },
    {
      "name": "shortest path uses endpoint bound by prior match",
      "cypher": "MATCH p=(c:NodeKind1)-->(u:NodeKind2) MATCH p2=shortestPath((u)-[*1..]->(d:NodeKind3)) RETURN p,p2 LIMIT 500",
      "fixture": {
        "nodes": [
          {"id": "a", "kinds": ["NodeKind1"], "properties": {}},
          {"id": "b", "kinds": ["NodeKind2"], "properties": {}},
          {"id": "c", "kinds": ["NodeKind2"], "properties": {}},
          {"id": "d", "kinds": ["NodeKind3"], "properties": {}},
          {"id": "x", "kinds": ["NodeKind1"], "properties": {}},
          {"id": "y", "kinds": ["NodeKind2"], "properties": {}}
        ],
        "edges": [
          {"start_id": "a", "end_id": "b", "kind": "EdgeKind1"},
          {"start_id": "b", "end_id": "c", "kind": "EdgeKind2"},
          {"start_id": "c", "end_id": "d", "kind": "EdgeKind2"},
          {"start_id": "x", "end_id": "y", "kind": "EdgeKind1"}
        ]
      },
      "assert": {
        "keys": ["p", "p2"],
        "row_count": 1,
        "path_node_ids": [["a", "b"], ["b", "c", "d"]],
        "path_lengths": [1, 2],
        "path_edge_kinds": [["EdgeKind1"], ["EdgeKind2", "EdgeKind2"]]
      }
    },
    {
      "name": "open shortest path preserves every prior match pair",
      "cypher": "MATCH (:SPResolutionEntry)-[:SPResolutionBind]->(s:SPResolutionRoot) MATCH p=shortestPath((s)-[:SPResolutionStep|SPResolutionAlternate*1..]->(e:SPResolutionTarget)) RETURN p",
      "fixture": {
        "nodes": [
          {"id": "entry", "kinds": ["SPResolutionEntry"], "properties": {}},
          {"id": "r1", "kinds": ["SPResolutionRoot"], "properties": {}},
          {"id": "r2", "kinds": ["SPResolutionRoot"], "properties": {}},
          {"id": "r3", "kinds": ["SPResolutionRoot"], "properties": {}},
          {"id": "mid", "kinds": ["SPResolutionMiddle"], "properties": {}},
          {"id": "near", "kinds": ["SPResolutionTarget"], "properties": {}},
          {"id": "far", "kinds": ["SPResolutionTarget"], "properties": {}},
          {"id": "unreachable", "kinds": ["SPResolutionTarget"], "properties": {}}
        ],
        "edges": [
          {"start_id": "entry", "end_id": "r1", "kind": "SPResolutionBind"},
          {"start_id": "entry", "end_id": "r2", "kind": "SPResolutionBind"},
          {"start_id": "entry", "end_id": "r3", "kind": "SPResolutionBind"},
          {"start_id": "r1", "end_id": "near", "kind": "SPResolutionStep"},
          {"start_id": "r1", "end_id": "near", "kind": "SPResolutionAlternate"},
          {"start_id": "r1", "end_id": "mid", "kind": "SPResolutionStep"},
          {"start_id": "r2", "end_id": "mid", "kind": "SPResolutionStep"},
          {"start_id": "mid", "end_id": "near", "kind": "SPResolutionStep"},
          {"start_id": "mid", "end_id": "far", "kind": "SPResolutionStep"}
        ]
      },
      "assert": {
        "row_count": 4,
        "path_node_ids": [["r1", "near"], ["r1", "mid", "far"], ["r2", "mid", "near"], ["r2", "mid", "far"]]
      }
    },
    {
      "name": "open shortest mutation updates every reachable terminal",
      "cypher": "MATCH (:SPResolutionEntry)-[:SPResolutionBind]->(s:SPResolutionRoot) MATCH p=shortestPath((s)-[:SPResolutionStep|SPResolutionAlternate*1..]->(e:SPResolutionTarget)) SET e.selected=true RETURN p",
      "fixture": {
        "nodes": [
          {"id": "entry", "kinds": ["SPResolutionEntry"], "properties": {}},
          {"id": "r1", "kinds": ["SPResolutionRoot"], "properties": {}},
          {"id": "r2", "kinds": ["SPResolutionRoot"], "properties": {}},
          {"id": "r3", "kinds": ["SPResolutionRoot"], "properties": {}},
          {"id": "mid", "kinds": ["SPResolutionMiddle"], "properties": {}},
          {"id": "near", "kinds": ["SPResolutionTarget"], "properties": {}},
          {"id": "far", "kinds": ["SPResolutionTarget"], "properties": {}},
          {"id": "unreachable", "kinds": ["SPResolutionTarget"], "properties": {}}
        ],
        "edges": [
          {"start_id": "entry", "end_id": "r1", "kind": "SPResolutionBind"},
          {"start_id": "entry", "end_id": "r2", "kind": "SPResolutionBind"},
          {"start_id": "entry", "end_id": "r3", "kind": "SPResolutionBind"},
          {"start_id": "r1", "end_id": "near", "kind": "SPResolutionStep"},
          {"start_id": "r1", "end_id": "near", "kind": "SPResolutionAlternate"},
          {"start_id": "r1", "end_id": "mid", "kind": "SPResolutionStep"},
          {"start_id": "r2", "end_id": "mid", "kind": "SPResolutionStep"},
          {"start_id": "mid", "end_id": "near", "kind": "SPResolutionStep"},
          {"start_id": "mid", "end_id": "far", "kind": "SPResolutionStep"}
        ]
      },
      "assert": {
        "row_count": 4,
        "path_node_ids": [["r1", "near"], ["r1", "mid", "far"], ["r2", "mid", "near"], ["r2", "mid", "far"]]
      },
      "post_assertions": [
        {
          "cypher": "MATCH (n) RETURN n",
          "assert": {
            "node_records": [
              {"id": "entry", "kinds": ["SPResolutionEntry"], "props": {}},
              {"id": "r1", "kinds": ["SPResolutionRoot"], "props": {}},
              {"id": "r2", "kinds": ["SPResolutionRoot"], "props": {}},
              {"id": "r3", "kinds": ["SPResolutionRoot"], "props": {}},
              {"id": "mid", "kinds": ["SPResolutionMiddle"], "props": {}},
              {"id": "near", "kinds": ["SPResolutionTarget"], "props": {"selected": true}},
              {"id": "far", "kinds": ["SPResolutionTarget"], "props": {"selected": true}},
              {"id": "unreachable", "kinds": ["SPResolutionTarget"], "props": {}}
            ]
          }
        }
      ]
    },
